#%RAML 1.0
title: Parking System API
version: v1
baseUri: /api/v1
mediaType: application/json

uses:
  parkingTypes: datatypes.raml
  traitsLib: traits.raml
  apiSecurity: security.raml

securedBy: [ apiSecurity.clientEnforcement ]

/health:
  get:
    description: Liveness health check.
    queryParameters:
      mode:
        required: false
        description: Use `verbose` for extended details.
    responses:
      200:
        body:
          application/json:
            example:
              { "timestamp": "2026-01-01T00:00:00Z", "status": "Running", "details": { "appName": "parking-system-api" } }
/health/ready:
  get:
    description: Readiness check (includes DB connectivity).
    is: [ traitsLib.Error503 ]
    responses:
      200:
        body:
          application/json:
            example:
              { "status": "Ready", "database": "connected" }

/zones:
  get:
    description: List parking zones with optional filters.
    queryParameters:
      city:
        required: false
        type: string
      limit:
        required: false
        type: integer
        default: 50
      offset:
        required: false
        type: integer
        default: 0
    responses:
      200:
        body:
          application/json:
            type: parkingTypes.ZoneList
  /{zoneId}:
    get:
      description: Get zone by ID.
      is: [ traitsLib.Error404 ]
      responses:
        200:
          body:
            application/json:
              type: parkingTypes.Zone
    /lots:
      get:
        description: List lots in a zone.
        queryParameters:
          isActive:
            required: false
            type: boolean
          lotType:
            required: false
            type: string
          limit:
            required: false
            type: integer
            default: 50
          offset:
            required: false
            type: integer
            default: 0
        responses:
          200:
            body:
              application/json:
                type: parkingTypes.LotList

/lots:
  get:
    description: List lots with optional zone/city filters.
    queryParameters:
      zoneCode:
        required: false
        type: string
      city:
        required: false
        type: string
      limit:
        required: false
        type: integer
        default: 50
      offset:
        required: false
        type: integer
        default: 0
    responses:
      200:
        body:
          application/json:
            type: parkingTypes.LotList
  /{lotId}:
    get:
      description: Get lot by ID.
      is: [ traitsLib.Error404 ]
      responses:
        200:
          body:
            application/json:
              type: parkingTypes.Lot
    /slots:
      get:
        description: List slots in a lot.
        queryParameters:
          status:
            required: false
            type: string
          slotType:
            required: false
            type: string
          limit:
            required: false
            type: integer
            default: 100
          offset:
            required: false
            type: integer
            default: 0
        responses:
          200:
            body:
              application/json:
                type: parkingTypes.SlotList
    /availability:
      get:
        description: Get availability summary for a lot.
        responses:
          200:
            body:
              application/json:
                type: parkingTypes.AvailabilitySummary

/slots/{slotId}:
  get:
    description: Get slot by ID.
    is: [ traitsLib.Error404 ]
    responses:
      200:
        body:
          application/json:
            type: parkingTypes.Slot
  patch:
    description: Update slot status (and record history).
    is: [ traitsLib.Error404 ]
    body:
      application/json:
        type: parkingTypes.SlotStatusUpdate
    responses:
      200:
        body:
          application/json:
            type: parkingTypes.Slot

/holds:
  post:
    description: Create a hold on a slot.
    is: [ traitsLib.Error400, traitsLib.Error409 ]
    body:
      application/json:
        type: parkingTypes.HoldRequest
    responses:
      201:
        body:
          application/json:
            type: parkingTypes.Hold
  /{holdId}:
    get:
      description: Get hold by ID.
      is: [ traitsLib.Error404 ]
      responses:
        200:
          body:
            application/json:
              type: parkingTypes.Hold
    delete:
      description: Release a hold.
      is: [ traitsLib.Error404 ]
      responses:
        200:
          body:
            application/json:
              type: parkingTypes.Hold

/reservations:
  get:
    description: List reservations with optional filters.
    queryParameters:
      userId:
        required: false
        type: string
      status:
        required: false
        type: string
      limit:
        required: false
        type: integer
        default: 50
      offset:
        required: false
        type: integer
        default: 0
    responses:
      200:
        body:
          application/json:
            type: parkingTypes.ReservationList
  post:
    description: Create a reservation.
    is: [ traitsLib.Error400, traitsLib.Error409 ]
    body:
      application/json:
        type: parkingTypes.ReservationRequest
    responses:
      201:
        body:
          application/json:
            type: parkingTypes.Reservation
  /{reservationId}:
    get:
      description: Get reservation by ID.
      is: [ traitsLib.Error404 ]
      responses:
        200:
          body:
            application/json:
              type: parkingTypes.Reservation
    patch:
      description: Update reservation (status, times, amount, payment).
      is: [ traitsLib.Error404 ]
      body:
        application/json:
          type: parkingTypes.ReservationUpdate
      responses:
        200:
          body:
            application/json:
              type: parkingTypes.Reservation
    /confirm:
      post:
        description: Confirm reservation.
        is: [ traitsLib.Error404 ]
        responses:
          200:
            body:
              application/json:
                type: parkingTypes.Reservation
    /cancel:
      post:
        description: Cancel reservation.
        is: [ traitsLib.Error404 ]
        responses:
          200:
            body:
              application/json:
                type: parkingTypes.Reservation
