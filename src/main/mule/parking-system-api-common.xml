<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:db="http://www.mulesoft.org/schema/mule/db"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

	<!-- Logger subflows: use existing DWLs; flow.name and app.name come from context. Optional: set vars.flowDescription before log-flow-end -->
	<sub-flow name="log-flow-start" doc:name="log-flow-start">
		<ee:transform doc:name="Build log payload (start)">
			<ee:message>
			</ee:message>
			<ee:variables >
				<ee:set-variable resource="dwl/log-start-of-flow.dwl" variableName="startLog" />
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Log flow start" message="#[write(vars.startLog, 'application/json')]" category="FlowStart" />
	</sub-flow>
	<sub-flow name="log-flow-end" doc:name="log-flow-end">
		<ee:transform doc:name="Build log payload (end)">
			<ee:message>
			</ee:message>
			<ee:variables >
				<ee:set-variable resource="dwl/log-end-of-flow.dwl" variableName="endLog" />
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Log flow end" message="#[write(vars.endLog, 'application/json')]" category="FlowEnd" />
	</sub-flow>

	<!-- DB common subflows: set vars.dbSql and vars.dbParams before flow-ref; result in payload -->
	<sub-flow name="db-select" doc:name="db-select">
		<db:select config-ref="AzureSQL_Config" doc:name="Execute select">
			<db:sql><![CDATA[#[vars.dbSql]]]></db:sql>
			<db:input-parameters><![CDATA[#[vars.dbParams]]]></db:input-parameters>
		</db:select>
	</sub-flow>
	<sub-flow name="db-insert" doc:name="db-insert">
		<db:insert config-ref="AzureSQL_Config" doc:name="Execute insert">
			<db:sql><![CDATA[#[vars.dbSql]]]></db:sql>
			<db:input-parameters><![CDATA[#[vars.dbParams]]]></db:input-parameters>
		</db:insert>
	</sub-flow>
	<sub-flow name="db-update" doc:name="db-update">
		<db:update config-ref="AzureSQL_Config" doc:name="Execute update">
			<db:sql><![CDATA[#[vars.dbSql]]]></db:sql>
			<db:input-parameters><![CDATA[#[vars.dbParams]]]></db:input-parameters>
		</db:update>
	</sub-flow>

	<!-- Not found: set vars.errorMessage before flow-ref; sets payload to Error type and vars.httpStatus=404 -->
	<sub-flow name="not-found" doc:name="not-found">
		<ee:transform doc:name="Error response (404)">
			<ee:message>
				<ee:set-payload resource="dwl/error-response.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="httpStatus">404</ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>

	<!-- Bad request: set vars.errorMessage (and optionally vars.errorCode) before flow-ref; sets payload to Error type and vars.httpStatus=400 -->
	<sub-flow name="bad-request" doc:name="bad-request">
		<ee:transform doc:name="Error response (400)">
			<ee:message>
				<ee:set-payload resource="dwl/error-response.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="httpStatus">400</ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>

	<!-- Conflict: set vars.errorMessage before flow-ref; sets payload to Error type and vars.httpStatus=409 -->
	<sub-flow name="conflict" doc:name="conflict">
		<ee:transform doc:name="Error response (409)">
			<ee:message>
				<ee:set-payload resource="dwl/error-response.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="httpStatus">409</ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
</mule>
