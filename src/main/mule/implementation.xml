		<set-variable value="50" variableName="defaultLimit" doc:name="Default limit" />
		<ee:transform doc:name="Pagination params">
			<ee:variables>
				<ee:set-variable variableName="paginationParams"><![CDATA[%dw 2.0
output application/java 
--- 
{ limit: min([100, max([1, (attributes.queryParams.limit default vars.defaultLimit default 50) as Number])]), 
	offset: max([0, (attributes.queryParams.offset default 0) as Number])
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Set dbSql and dbParams">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="dbSql"><![CDATA["SELECT * FROM parking_zones WHERE (CAST(:city AS NVARCHAR(50)) IS NULL OR city = :city) ORDER BY zone_name OFFSET :offset ROWS FETCH NEXT :limit ROWS ONLY"]]></ee:set-variable>
