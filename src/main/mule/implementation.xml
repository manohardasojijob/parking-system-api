	<flow name="impl-patch-slot" doc:name="impl-patch-slot">
		<flow-ref name="log-flow-start" doc:name="log-flow-start" />
		<ee:transform doc:name="Set slotId and patchBody">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="slotId">attributes.uriParams.slotId</ee:set-variable>
				<ee:set-variable variableName="patchBody">payload</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Validate status (allowlist to prevent injection)">
			<when expression="#[vars.patchBody == null or (vars.patchBody.status default '') == '' or !(['AVAILABLE','OCCUPIED','RESERVED','MAINTENANCE','OFFLINE'] contains (vars.patchBody.status default ''))]">
				<ee:transform doc:name="Set error vars (bad-request)">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="errorMessage">"Invalid status. Allowed: AVAILABLE, OCCUPIED, RESERVED, MAINTENANCE, OFFLINE"</ee:set-variable>
						<ee:set-variable variableName="errorCode">"VALIDATION"</ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref name="log-flow-end" doc:name="log-flow-end" />
				<flow-ref name="bad-request" doc:name="bad-request" />
			</when>
			<otherwise>
				<ee:transform doc:name="Set dbSql and dbParams">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="dbSql"><![CDATA["SELECT * FROM parking_slots WHERE slot_id = CAST(:slotId AS UNIQUEIDENTIFIER)"]]></ee:set-variable>
						<ee:set-variable variableName="dbParams"><![CDATA[%dw 2.0
output application/java
---
{ slotId: vars.slotId }]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref name="db-select" doc:name="db-select" />
				<choice doc:name="Slot found?">
					<when expression="#[sizeOf(payload) == 0]">
						<set-variable value="Slot not found" variableName="errorMessage" doc:name="Set error message" />
						<flow-ref name="log-flow-end" doc:name="log-flow-end" />
						<flow-ref name="not-found" doc:name="not-found" />
					</when>
					<otherwise>
						<ee:transform doc:name="Set previousStatus">
							<ee:variables>
								<ee:set-variable variableName="previousStatus">payload[0].status</ee:set-variable>
							</ee:variables>
						</ee:transform>
						<ee:transform doc:name="Set dbSql and dbParams (update slot)">
							<ee:message />
							<ee:variables>
								<ee:set-variable variableName="dbSql"><![CDATA["UPDATE parking_slots SET status = :status, last_status_change = GETUTCDATE(), updated_at = GETUTCDATE() WHERE slot_id = CAST(:slotId AS UNIQUEIDENTIFIER)"]]></ee:set-variable>
								<ee:set-variable variableName="dbParams"><![CDATA[#[output application/java --- { status: vars.patchBody.status, slotId: vars.slotId }]]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref name="db-update" doc:name="db-update" />
						<ee:transform doc:name="Set dbSql and dbParams (insert history)">
							<ee:message />
							<ee:variables>
								<ee:set-variable variableName="dbSql"><![CDATA["INSERT INTO slot_status_history (slot_id, previous_status, new_status, event_source, event_id) VALUES (CAST(:slotId AS UNIQUEIDENTIFIER), :previousStatus, :newStatus, :eventSource, :eventId)"]]></ee:set-variable>
								<ee:set-variable variableName="dbParams"><![CDATA[#[output application/java --- { slotId: vars.slotId, previousStatus: vars.previousStatus, newStatus: vars.patchBody.status, eventSource: vars.patchBody.eventSource default null, eventId: vars.patchBody.eventId default null }]]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref name="db-insert" doc:name="db-insert" />
						<ee:transform doc:name="Set dbSql and dbParams (select slot)">
							<ee:message />
							<ee:variables>
								<ee:set-variable variableName="dbSql"><![CDATA["SELECT * FROM parking_slots WHERE slot_id = CAST(:slotId AS UNIQUEIDENTIFIER)"]]></ee:set-variable>
								<ee:set-variable variableName="dbParams"><![CDATA[%dw 2.0
output application/java
---
{ slotId: vars.slotId }]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref name="db-select" doc:name="db-select" />
						<flow-ref name="log-flow-end" doc:name="log-flow-end" />
						<ee:transform doc:name="To Slot JSON">
							<ee:message><ee:set-payload resource="dwl/slot-to-json.dwl" /></ee:message>
						</ee:transform>
					</otherwise>
				</choice>
			</otherwise>
		</choice>
	</flow>

	<flow name="impl-post-holds" doc:name="impl-post-holds">
		<flow-ref name="log-flow-start" doc:name="log-flow-start" />
		<set-variable value="#[payload]" variableName="holdRequest" doc:name="Store request body" />
		<choice doc:name="Validate request">
			<when expression="#[vars.holdRequest == null or vars.holdRequest.slotId == null or vars.holdRequest.userId == null or vars.holdRequest.holdExpiryMinutes == null or (vars.holdRequest.holdExpiryMinutes as Number) &lt; 1 or (vars.holdRequest.holdExpiryMinutes as Number) &gt; 120]">
				<ee:transform doc:name="Set error vars (bad-request)">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="errorMessage">"Missing or invalid fields: slotId, userId, holdExpiryMinutes (1-120 required)"</ee:set-variable>
						<ee:set-variable variableName="errorCode">"VALIDATION"</ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref name="log-flow-end" doc:name="log-flow-end" />
				<flow-ref name="bad-request" doc:name="bad-request" />
			</when>
			<otherwise>
				<ee:transform doc:name="Set dbSql and dbParams">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="dbSql"><![CDATA["SELECT * FROM parking_slots WHERE slot_id = CAST(:slotId AS UNIQUEIDENTIFIER) AND status = 'AVAILABLE'"]]></ee:set-variable>
						<ee:set-variable variableName="dbParams"><![CDATA[%dw 2.0
output application/java
---
{ slotId: vars.holdRequest.slotId }]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref name="db-select" doc:name="db-select" />
				<choice doc:name="Available?">
					<when expression="#[sizeOf(payload) == 0]">
						<set-variable value="Slot not available or not found" variableName="errorMessage" doc:name="Set error message" />
						<flow-ref name="log-flow-end" doc:name="log-flow-end" />
						<flow-ref name="conflict" doc:name="conflict" />
					</when>
					<otherwise>
						<ee:transform doc:name="Set dbSql and dbParams (insert hold)">
							<ee:message />
							<ee:variables>
								<ee:set-variable variableName="dbSql"><![CDATA["INSERT INTO holds (slot_id, user_id, hold_expiry) VALUES (CAST(:slotId AS UNIQUEIDENTIFIER), CAST(:userId AS UNIQUEIDENTIFIER), DATEADD(MINUTE, :holdExpiryMinutes, GETUTCDATE()))"]]></ee:set-variable>
								<ee:set-variable variableName="dbParams"><![CDATA[#[output application/java --- { slotId: vars.holdRequest.slotId, userId: vars.holdRequest.userId, holdExpiryMinutes: vars.holdRequest.holdExpiryMinutes as Number }]]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
